* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.npz binary
*.pdf binary
*.docx binary
# Scientific manifests pin exact bytes, including their existing line endings.
data/** -text
