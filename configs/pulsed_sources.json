    "neutral_low_energy": "constant"
  },
  "performance": {
    "workers": 2,
    "radiation_backend": "numpy",
    "collision_cache_mb": 128
  },
  "solver": {
    "t_end_s": 2e-08,
    "max_step_s": 1e-09,
    "min_step_s": 1e-16,
    "samples": 7,
    "max_steps": 100000
