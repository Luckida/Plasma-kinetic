  "heavy_initial": {
    "H": {
      "Ti_K": 300.0
    },
    "He": {
      "Ti_K": 300.0
    }
  },
  "phase_grid": {
    "energy_min_eV": 1e-05,
    "energy_max_eV": "auto",
    "energy_points": 32,
    "angular_points": 4
  },
  "heavy_phase_grid": {
    "energy_min_eV": 1e-06,
    "energy_max_eV": "auto",
    "energy_points": 16,
    "angular_points": 4
  },
  "cells": 2,
  "thickness_cm": 0.01,
  "particle_boundary": {
    "kind": "periodic"
  },
  "electric_field": {
    "mode": "prescribed",
    "Ez_V_cm": 0.0
  },
  "radiation": {
    "scale": 0.0,
    "continuum_points": 200,
