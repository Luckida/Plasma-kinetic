      "normalization": "integral",
      "spectrum_mode": "probe",
      "spectrum_file": "",
      "spectrum_options": {
        "x_unit": "auto",
        "y_kind": "relative"
      },
      "multiplier_W_cm2": 1.0,
      "mu": 1.0,
      "direction": "both"
