  "gas": {
    "mode": "densities",
    "temperature_K": 300000.0,
    "components": [
      {
        "species": "H",
        "density_cm3": 1000000000.0
      },
      {
        "species": "He",
        "density_cm3": 9000000000.0
      }
    ],
    "distributions": {
      "default": {
        "kind": "maxwellian",
