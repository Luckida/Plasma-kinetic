  "diagnostics": {
    "reaction_levels": [
      "H",
      "He"
    ],
    "phase_history_csv": false,
    "plots_on_finish": false,
    "output_mode": "compact"
  },
  "progress": {
    "mode": "text",
    "interval_s": 0.5
  },
  "output_directory": "../outputs/output_gas_probe",
  "chemistry": {
    "enabled": true,
    "rate_policy": "maxwellian_moments",
    "disabled_ids": [
      "LS05:Hplus_H:CX"
    ],
    "directory": "../data/reactions",
    "components_directory": "../data/components",
    "allow_estimated_rates": false
