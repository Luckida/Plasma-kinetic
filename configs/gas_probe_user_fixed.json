    {
      "id": "Источник 2",
      "mode": "radiation",
      "enabled": true,
      "position_cm": 0.5,
      "width_cm": 0.0,
      "start_s": 1e-08,
      "stop_s": 2e-08,
      "normalization": "integral",
      "spectrum_mode": "probe",
      "spectrum_file": "",
      "spectrum_options": {
        "x_unit": "auto",
        "y_kind": "relative"
      },
      "multiplier_W_cm2": 100.0,
      "mu": 1.0,
      "direction": "both"
    }
  ],
  "probe": {
    "mode": "flat",
    "minimum_nm": 1082.0,
    "maximum_nm": 1084.0,
    "points": 501
  }
