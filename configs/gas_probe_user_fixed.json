{
  "schema": "MixtureKineticSlab-2.1",
  "atomic_data": {
    "species": [
      "H I",
      "He I"
    ],
    "nmax": 9,
    "prepared_directory": "../data/elements",
    "offline": true,
    "element_directory": "../data/elements",
    "cache_directory": "../cache/atomic_sources"
  },
  "initial_cm3": {
    "H": 1000000000.0,
    "He": 9000000000.0
  },
  "level_selection": {
    "mode": "auto",
    "relative_tolerance": 1e-06,
    "forced_levels": [
      "He_0:L002",
      "He_0:L004"
    ],
    "missing_data": "report"
  },
  "electron_initial": {
    "kind": "maxwellian",
    "Te_eV": 30.0,
    "match_moments": true
  },
  "heavy_initial": {
    "H": {
      "kind": "maxwellian",
      "Ti_K": 300000.0,
      "match_moments": true
    },
    "He": {
      "kind": "maxwellian",
      "Ti_K": 300000.0,
      "match_moments": true
    }
  },
  "phase_grid": {
    "energy_min_eV": 1e-05,
    "energy_max_eV": "auto",
    "energy_points": 32,
    "angular_points": 4
  },
  "heavy_phase_grid": {
    "energy_min_eV": 1e-06,
    "energy_max_eV": "auto",
    "energy_points": 16,
    "angular_points": 4
  },
  "cells": 10,
  "thickness_cm": 1.0,
  "particle_boundary": {
    "kind": "periodic"
  },
  "electric_field": {
    "mode": "prescribed",
    "Ez_V_cm": 0.0
  },
  "radiation": {
    "scale": 1.0,
    "continuum_points": 200,
    "line_points": 41,
    "Tn_K": 300000.0,
    "angular_points": 4,
    "enabled": true,
    "electron_scattering": false,
    "normalization": "integral",
    "spectrum_mode": "probe",
    "spectrum_file": "",
    "spectrum_options": {
      "x_unit": "auto",
      "y_kind": "relative"
    },
    "multiplier_W_cm2": 100.0,
    "beam_mu": 1.0,
    "start_s": 1e-08,
    "stop_s": 2e-08,
    "left_diffuse_scale": 0.0,
    "right_diffuse_scale": 0.0
  },
  "processes": {},
  "collisions": {
    "ee_bgk": false,
    "ii_bgk": false,
    "ei_binary": false,
    "neutral_elastic": false,
    "coulomb_log": 10.0,
    "maximum_phase_loss": 0.2,
    "relative_azimuth_points": 2,
    "scattering_azimuth_points": 2,
    "neutral_low_energy": "constant"
  },
  "performance": {
    "workers": 2,
    "radiation_backend": "numpy",
    "collision_cache_mb": 128
  },
  "solver": {
    "t_end_s": 2e-07,
    "max_step_s": 2e-09,
    "min_step_s": 1e-16,
    "samples": 5,
    "max_steps": 100000
